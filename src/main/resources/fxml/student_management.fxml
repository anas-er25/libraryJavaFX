<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.StudentController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Manage Students" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- Form for Add/Update -->
    <HBox spacing="10">
        <TextField fx:id="nameField" promptText="Name"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <TextField fx:id="userIdField" promptText="User ID"/>
        <Button text="Add Student" onAction="#addStudent"/>
        <Button text="Update Student" onAction="#updateStudent"/>
    </HBox>

    <!-- Table for Listing -->
    <TableView fx:id="studentTable">
        <columns>
            <TableColumn fx:id="idColumn" text="ID"/>
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="emailColumn" text="Email"/>
            <TableColumn fx:id="userIdColumn" text="User ID"/>
        </columns>
    </TableView>

    <Button text="Delete Selected" onAction="#deleteStudent"/>
</VBox>