<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom, #e6f3ff, #b3d9ff);" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.BookController">
    <center>
        <VBox alignment="TOP_CENTER" spacing="15" maxWidth="800" style="-fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 30; -fx-border-color: #cccccc; -fx-border-width: 1;">
            <effect>
                <DropShadow radius="10" color="#00000033"/>
            </effect>
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <Label text="Manage Books" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-alignment: center;"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="titleField" promptText="Title" style="-fx-pref-width: 200; -fx-pref-height: 40; -fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 10;"/>
                <TextField fx:id="authorField" promptText="Author" style="-fx-pref-width: 200; -fx-pref-height: 40; -fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 10;"/>
                <ComboBox fx:id="categoryComboBox" promptText="Select Category" style="-fx-pref-width: 200; -fx-pref-height: 40; -fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 14px; -fx-padding: 5;"/>
                <Button text="Add Book" onAction="#addBook" style="-fx-pref-width: 120; -fx-pref-height: 40; -fx-background-color: #2ecc71; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Update Book" onAction="#updateBook" style="-fx-pref-width: 120; -fx-pref-height: 40; -fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
            <TableView fx:id="bookTable" style="-fx-pref-height: 300; -fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="titleColumn" text="Title" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="authorColumn" text="Author" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="categoryIdColumn" text="Category" style="-fx-alignment: CENTER-LEFT;"/>
                </columns>
            </TableView>
            <Button text="Delete Selected" onAction="#deleteBook" style="-fx-pref-width: 150; -fx-pref-height: 40; -fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>
    </center>
</BorderPane>